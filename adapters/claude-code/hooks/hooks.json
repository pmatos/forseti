{
  "description": "Forseti verify-gate: PostToolUse verifies edited C functions with ESBMC (function-level, no harness) and re-verifies C files written out-of-band via Bash; Stop blocks the turn from ending until every touched unit is VERIFIED up to k.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "forseti claude-code-hook session-start",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "forseti claude-code-hook post-tool-use",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "forseti claude-code-hook post-bash",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "forseti claude-code-hook stop-gate",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
