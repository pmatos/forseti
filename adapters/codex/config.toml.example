# Forseti — Codex adapter configuration.
#
# `forseti enable-project --harness codex` (#212) writes/updates (2) for you —
# see src/forseti/adapters/codex/install.py. This file is now mainly a reference
# for the two pieces `enable-project` deliberately does NOT manage: (1) the
# top-level `notify` reminder (project-local `notify` is rejected by Codex
# 0.148 -- it is a user-level-only key, so wire it into your own
# ~/.codex/config.toml, not a project's) and (3) the Core MCP server
# registration. The enforcing gate is (2); (1) and ./AGENTS.md back it up.
#
# ORDER MATTERS: `notify` is a top-level key, so it must appear BEFORE any
# `[table]` / `[[table]]` header — TOML assigns every key after a header to that
# table, which would silently turn `notify` into `mcp_servers.forseti.notify`
# (and Codex, reading only a top-level `notify`, would never run it).

# (1) Turn-end reminder (post-turn, non-blocking). User-level only (see above) --
# merge into ~/.codex/config.toml, never a project's .codex/config.toml. Codex
# passes the notify program a single JSON argument; use an absolute path.
notify = ["python3", "/absolute/path/to/adapters/codex/notify.py"]

# (2) The gate: verify after every apply_patch edit and block on a counterexample
# (see src/forseti/adapters/codex/verify_hook.py). matcher may be apply_patch,
# Edit, or Write; the hook input reports tool_name = "apply_patch" either way.
# Uses the SDK-free `forseti verify` CLI, so esbmc must be on PATH. The command
# is the stable `forseti codex-hook verify` -- dispatched in-process by the
# installed `forseti`, never an absolute script path -- exactly what
# `forseti enable-project --harness codex` generates.
[[hooks.PostToolUse]]
matcher = "apply_patch"

[[hooks.PostToolUse.hooks]]
type = "command"
command = "forseti codex-hook verify"
timeout = 120
statusMessage = "Forseti: verifying edited unit"

# (3) Forseti Core over MCP (stdio) — lets the model call `verify`/`propose`/
# `submit`/`check`/`semantic_loop` directly (./AGENTS.md's semantic-property
# section, #213). `forseti mcp` starts the server (#49); it needs the `mcp` extra:
#   pip install 'forseti[mcp]'
# Equivalent CLI:  codex mcp add forseti -- forseti mcp
[mcp_servers.forseti]
command = "forseti"
args = ["mcp"]
# startup_timeout_sec = 10           # bump if esbmc/import warm-up is slow
